{
  "info": {
    "name": "Gestor de Conciertos API",
    "description": "API REST del Gestor de Conciertos. Ejecuta primero «Iniciar sesión»: guarda el token y las demás peticiones lo envían en la cabecera Authorization: Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://gestor-conciertos.onrender.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "evento_id",
      "value": "1"
    },
    {
      "key": "artista_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Devuelve un token de Sanctum. El script lo guarda en la variable token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "logout"
              ]
            },
            "description": "Revoca el token usado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Eventos",
      "item": [
        {
          "name": "Listar próximos eventos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/eventos?proximos=1&por_pagina=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "eventos"
              ],
              "query": [
                {
                  "key": "proximos",
                  "value": "1"
                },
                {
                  "key": "por_pagina",
                  "value": "10"
                }
              ]
            },
            "description": "Consulta pública, sin token.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver un evento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/eventos/{{evento_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "eventos",
                "{{evento_id}}"
              ]
            },
            "description": "Detalle con su artista.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Artistas (admin)",
      "item": [
        {
          "name": "Crear artista",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/artistas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "artistas"
              ]
            },
            "description": "Requiere token de admin. Guarda el id en artista_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Artista desde Postman\",\n  \"generos\": \"Rock\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('artista_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar artista",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/artistas/{{artista_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "artistas",
                "{{artista_id}}"
              ]
            },
            "description": "Requiere token de admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Artista editado desde Postman\",\n  \"generos\": \"Rock, Pop\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar artista",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/artistas/{{artista_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "artistas",
                "{{artista_id}}"
              ]
            },
            "description": "Requiere token de admin. Borra también sus eventos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Favoritos",
      "item": [
        {
          "name": "Agregar a favoritos",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/favoritos/{{evento_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "favoritos",
                "{{evento_id}}"
              ]
            },
            "description": "Agrega el evento a los favoritos del dueño del token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis favoritos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/favoritos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "favoritos"
              ]
            },
            "description": "Eventos favoritos del dueño del token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Quitar de favoritos",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/favoritos/{{evento_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "favoritos",
                "{{evento_id}}"
              ]
            },
            "description": "Quita el evento de los favoritos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}